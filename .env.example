# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file — it is gitignored.

ENV=development
LOG_LEVEL=INFO

# Local docker-compose default (host port 5435 — several other local projects on this
# machine already occupy 5432-5434, see docker-compose.yml); override for managed Postgres
# in deployment.
DATABASE_URL=postgresql+psycopg://voc:voc@localhost:5435/voc

# Generate a real random secret for any non-local environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-env
JWT_EXPIRES_MINUTES=720

# Single-admin credentials (ADR-5: no RBAC/signup flow for v1). Change the password
# before deploying anywhere reachable.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-env

# Optional: leave blank to disable Sentry locally.
SENTRY_DSN=

# Required for AI analysis (Phase 3+) — without it, POST /analysis/run and the
# scripts/run_analysis.py / scripts/evaluate_ai_analysis.py scripts fail fast with a
# clear error rather than touching any review rows. Not needed for Phases 1-2.
ANTHROPIC_API_KEY=
# Haiku-class by default: sentiment/topic/aspect extraction is high-volume classification,
# not a task that needs a larger model.
ANALYSIS_MODEL=claude-haiku-4-5-20251001
ANALYSIS_TIMEOUT_SECONDS=30

# Comma-separated list of origins allowed to call the API (the deployed frontend + local dev).
CORS_ALLOWED_ORIGINS=http://localhost:3000
